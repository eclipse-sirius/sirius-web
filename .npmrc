@ObeoNetwork:registry=https://npm.pkg.github.com/ObeoNetwork

# Enforce a cooldown period before adding dependencies to newly released package versions
min-release-age=7
min-release-age-exclude[]=@ObeoNetwork/*

# Never bypass the lifecycle-script allowlist.
dangerously-allow-all-scripts=false

# Treat unapproved dependency lifecycle scripts as errors.
strict-allow-scripts=true

# npm 11.9+: prevent Git dependencies from altering Git's install-time behavior.
allow-git=none

# When publishing, publicly link the published package to where it was built and published.
provenance=true
