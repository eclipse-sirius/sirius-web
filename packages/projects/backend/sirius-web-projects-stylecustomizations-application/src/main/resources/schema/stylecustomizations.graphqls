extend type Project {
  styleCustomizations(first: Int, after: String, last: Int, before: String): ProjectStyleCustomizationsConnection!
}

type ProjectStyleCustomizationsConnection {
  edges: [ProjectStyleCustomizationsEdge!]!
  pageInfo: PageInfo!
}

type ProjectStyleCustomizationsEdge {
  node: StyleCustomization!
  cursor: String!
}

type StyleCustomization {
  id: ID!
  name: String!
  description: String!
  enabled: Boolean!
}

extend type Mutation {
  updateProjectStyleCustomizationState(input: UpdateProjectStyleCustomizationStateInput!): UpdateProjectStyleCustomizationStatePayload!
}

input UpdateProjectStyleCustomizationStateInput {
  id: ID!
  projectId: ID!
  styleCustomizationDescriptionId: ID!
  enable: Boolean!
}

union UpdateProjectStyleCustomizationStatePayload = SuccessPayload | ErrorPayload
