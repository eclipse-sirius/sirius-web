<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="02-add-project-style-customization-unique-constraint" author="gcoutable">

        <sql>
            <!-- Remove duplicates before applying the unique constraint -->
            DELETE FROM project_style_customization AS duplicate
                USING project_style_customization AS kept
            WHERE duplicate.project_id = kept.project_id
              AND duplicate.style_customization_description_id = kept.style_customization_description_id
              AND (duplicate.created_on, duplicate.id) > (kept.created_on, kept.id);
        </sql>

        <addUniqueConstraint tableName="project_style_customization" columnNames="project_id, style_customization_description_id" />
    </changeSet>
</databaseChangeLog>
